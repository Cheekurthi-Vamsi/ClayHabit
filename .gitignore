# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.apk
*.aab
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.idea/

# Env files: never committed, at any depth (.env, .env.local, .env.production, web/.env …).
# Deploys get their values from Vercel's environment variables.
.env
.env.*
**/.env
**/.env.*

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Built Android releases (uploaded to GitHub Releases, not committed)
/release/

# Native build output of the local Expo modules (Gradle / Xcode)
/modules/*/android/build/
/modules/*/android/.gradle/
/modules/*/ios/build/
