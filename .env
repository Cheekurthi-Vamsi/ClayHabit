# Copy to .env.local (git-ignored) and fill in to turn on sign-in.
# Without a key the app runs local-only, exactly as before.
# Clerk Dashboard → your application → API keys → Publishable key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Z29vZC1iYWJvb24tNzM0NS5jbGVyay5hY2NvdW50cy5kZXYk

# Google OAuth client IDs (Google Cloud Console → APIs & Services → Credentials).
# Client IDs are public identifiers, not secrets. Never put a client secret here.
# Web client: Google sign-in on the phone (ID token audience) and Drive in the web app (web/).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=698831638780-bti5st9f0jorueehp79g1g4q4n2gae4n.apps.googleusercontent.com
# Android client: Google matches it by package (com.kernalpanic.clayhabit) + signing SHA-1,
# so the app never sends it; kept here for reference. Paste it from Google Cloud Console.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
