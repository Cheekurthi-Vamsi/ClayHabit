{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"],
    "paths": {
      "expo-sqlite": ["./src/shims/expo-sqlite.ts"],
      "@/lib/notifications/notification-service": ["./src/shims/notification-service.ts"],
      "@/assets/*": ["../assets/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
