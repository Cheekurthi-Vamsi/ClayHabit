{
  "name": "clayhabit",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@clerk/expo": "^4.6.8",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@expo/ui": "~57.0.19",
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.103.1",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:apk": "node scripts/build-android.mjs apk",
    "android:aab": "node scripts/build-android.mjs aab",
    "release:android": "node scripts/release-android.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "icons:extract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/extract-habit-icons.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/web/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@noble/.*)"
    ]
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@solana-mobile/mobile-wallet-adapter-protocol"
        ]
      }
    }
  },
  "overrides": {
    "jayson": {
      "uuid": "^11.1.1"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
